{
  "name": "@team-kb/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "tsx --test src/app.test.ts",
    "test:db": "tsx --test src/auth.integration.test.ts src/chat.integration.test.ts src/knowledge.integration.test.ts src/tasks.integration.test.ts",
    "eval": "tsx src/evaluation.ts",
    "eval:live": "tsx src/evaluation.ts --live",
    "db:migrate": "tsx src/migrate.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.0.2",
    "@fastify/rate-limit": "^11.2.1",
    "dotenv": "^18.0.6",
    "fastify": "^5.2.1",
    "openai": "^6.49.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
