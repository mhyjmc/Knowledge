# 实际配置由 npm run db:setup 生成，以下仅为说明，不要使用示例密码。
POSTGRES_PASSWORD=replace_with_random_password
DATABASE_URL=postgresql://team_kb:replace_with_random_password@127.0.0.1:5433/team_knowledge
# 本地 HTTP 为 false；正式 HTTPS 部署必须设为 true。
COOKIE_SECURE=false
APP_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
LLM_BASE_URL=https://llmtoken.io/v1
LLM_MODEL=gpt-6.1-sol
LLM_API_KEY=
LLM_API_MODE=responses
LLM_REASONING_EFFORT=low
LLM_MAX_OUTPUT_TOKENS=1024
