{
  "name": "team-knowledge-assistant",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "typecheck": "npm run typecheck --workspaces",
    "build": "npm run build --workspaces",
    "test": "npm run test -w @team-kb/server",
    "test:db": "npm run test:db -w @team-kb/server",
    "eval": "npm run eval -w @team-kb/server",
    "eval:live": "npm run eval:live -w @team-kb/server",
    "db:setup": "node scripts/setup-db.mjs",
    "db:up": "docker compose up -d --wait",
    "db:stop": "docker compose stop",
    "db:migrate": "npm run db:migrate -w @team-kb/server",
    "db:local": "node scripts/local-db.mjs"
    ,"prod:up": "docker compose -f compose.production.yaml --env-file deploy/.env.production up -d --build --wait"
    ,"prod:down": "docker compose -f compose.production.yaml --env-file deploy/.env.production down"
    ,"prod:logs": "docker compose -f compose.production.yaml --env-file deploy/.env.production logs -f --tail=100"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "dotenv": "^18.0.6",
    "embedded-postgres": "17.10.0-beta.17"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
